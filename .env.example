# ==============================================================================
# HydroPulse Water SCADA Twin & Anomaly Dashboard — Environment Template
# ==============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env

# --- Security & Authentication Secrets ---
SCADA_API_KEY=your-scada-api-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here
ENVIRONMENT=development

# --- Server & Network Configuration ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Water Utility Business & Tariff Parameters ---
# Standard energy tariff: 1.00 PLN / kWh
ELECTRICITY_TARIFF_PLN_KWH=1.00

# --- Hydraulic Baseline Constants ---
PZ1_SEU_KWH_M3=0.08
PNB1_SEU_KWH_M3=0.31
DEFAULT_SEU_KWH_M3=0.24

# --- Dataset Storage Paths ---
# Leave empty to use repository ./Dane
DATA_DIR=

# --- Frontend Client Configuration ---
VITE_API_BASE_URL=/api
VITE_WS_URL=ws://localhost:8000/ws/telemetry
VITE_APP_TITLE=HydroPulse — PWiK Rybnik
